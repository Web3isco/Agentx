# ────────────────────────────────────────────────────────────────
# AGENTX — Environment Variables
#
# Copy this file to `.env.local` (local dev) or set in your Vercel
# project's Environment Variables for production.
#
# IMPORTANT:
#  * All `NEXT_PUBLIC_*` values are inlined into the client bundle at
#    build time. They MUST be public — contract addresses and public
#    RPC endpoints. NEVER put private keys or API secrets in these.
#  * `APEX_TEST_PRIVATE_KEY` is the ONLY server-only secret. It is used
#    exclusively by the local onchain test scripts (`scripts/*.js`) and
#    is NOT read by the deployed application. Leave it empty / unset in
#    production; never hardcode it and never set it as NEXT_PUBLIC_.
#  * All variables are OPTIONAL — the app ships sensible public defaults
#    (shown below) for every READ path. Only set a variable to override.
# ────────────────────────────────────────────────────────────────

# ── ERC-8004 Identity Registry ─────────────────────────────────
# Official deployed IdentityRegistry (ERC-721) addresses.
# Source: https://github.com/erc-8004/erc-8004-contracts
NEXT_PUBLIC_ERC8004_CONTRACT_ADDRESS_BSC_TESTNET=0x8004A818BFB912233c491871b3d84c89A494BD9e
NEXT_PUBLIC_ERC8004_CONTRACT_ADDRESS_BSC_MAINNET=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432

# ── ERC-8004 Reputation Registry ──────────────────────────────
# Official deployed Reputation Registry proxies (verified 2.0.0).
NEXT_PUBLIC_REPUTATION_REGISTRY_ADDRESS=0x8004B663056A597Dffe9eCcC1965A193B7388713
NEXT_PUBLIC_REPUTATION_REGISTRY_ADDRESS_MAINNET=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63

# ── ERC-8183 APEX — BSC Testnet (chainId 97, ACTIVE) ──────────
# Official AgenticCommerce kernel, EvaluatorRouter and OptimisticPolicy
# proxy addresses + the payment token (U). Defaults match the app fallback.
# Source: https://github.com/bnb-chain/apex-contracts/blob/main/scripts/addresses.ts
NEXT_PUBLIC_APEX_COMMERCE_ADDRESS=0xa206c0517b6371c6638cd9e4a42cc9f02a33b0de
NEXT_PUBLIC_APEX_ROUTER_ADDRESS=0xd7d36d66d2f1b608a0f943f722d27e3744f66f25
NEXT_PUBLIC_APEX_POLICY_ADDRESS=0xd6a4217588f6b1f5657a92a3e94e6422ad771cea
NEXT_PUBLIC_APEX_PAYMENT_TOKEN=0xc70B8741B8B07A6d61E54fd4B20f22Fa648E5565

# ── ERC-8183 APEX — BSC Mainnet (chainId 56, read-capable) ────
# Mainnet deployments are present in config but NOT the active hire
# network. The app writes to BSC Testnet only.
NEXT_PUBLIC_APEX_COMMERCE_ADDRESS_MAINNET=0xea4daa3100a767e86fded867729ae7446476eba6
NEXT_PUBLIC_APEX_ROUTER_ADDRESS_MAINNET=0x51895229e12f9876011789b04f8698af06ccd6da
NEXT_PUBLIC_APEX_POLICY_ADDRESS_MAINNET=0x9c01845705b3078aa2e8cff7520a6376fd766de5
NEXT_PUBLIC_APEX_PAYMENT_TOKEN_MAINNET=0xcE24439F2D9C6a2289F741120FE202248B666666

# ── BSC RPC endpoints (public) ─────────────────────────────────
# Used by all onchain reads (ERC-8004 verification, reputation, hires).
NEXT_PUBLIC_BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com
NEXT_PUBLIC_BSC_MAINNET_RPC_URL=https://bsc-rpc.publicnode.com

# ── Server-only (optional) ─────────────────────────────────────
# Local onchain lifecycle test scripts only (scripts/test-hire-lifecycle.js,
# scripts/test-job-execute.js). NOT read by the deployed app. NEVER set as
# a NEXT_PUBLIC_ variable. Leave empty/unset in production and CI. Do NOT
# commit a real value.
# APEX_TEST_PRIVATE_KEY=